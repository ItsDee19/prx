# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# On Vercel this is set automatically when you connect a Neon Postgres
# database to the project (Storage -> Create Database -> Neon).
# For local development against that same database, run:
#   vercel env pull .env.local
# Or skip this entirely and use `npm run dev:local`, which starts an
# embedded Postgres in ./data/pglite and sets DATABASE_URL for you.
DATABASE_URL=

# Optional: connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# Sign-up
# ---------------------------------------------------------------------------
# Comma-separated list of email domains allowed to self-register at /register.
# Leave empty to allow any email address. Admins can always add users from /team.
ALLOWED_EMAIL_DOMAINS=avlysai.com
