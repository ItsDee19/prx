# PRX environment variables. Copy to .env.local for local development.
# PRX ships with no demo data: the first person to register at /register
# becomes the admin.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# On Vercel this is set automatically when you connect a Neon Postgres
# database to the project (Storage -> Create Database -> Neon).
# For local development against that same database, run:
#   vercel env pull .env.local
# Or skip this entirely and use `npm run dev:local`, which starts an
# embedded Postgres in ./data/pglite and sets DATABASE_URL for you.
DATABASE_URL=

# Optional: connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# Sign-up
# ---------------------------------------------------------------------------
# Comma-separated list of email domains allowed to self-register at /register.
# Leave empty to allow any email address. Admins can always add users from /team.
# The first account registered on an empty database becomes the admin.
ALLOWED_EMAIL_DOMAINS=avlysai.com

# ---------------------------------------------------------------------------
# File attachments (optional)
# ---------------------------------------------------------------------------
# Read-write token of a Vercel Blob store. On Vercel it is set automatically
# when you connect a Blob store to the project (Storage -> Create -> Blob);
# for local development copy it with `vercel env pull .env.local`.
# Without it PRX still works: projects and tasks accept link attachments only,
# and the Files tab explains that uploads are off. Uploads are limited to
# 25 MB and to common document, image, audio and video types.
# BLOB_READ_WRITE_TOKEN=
